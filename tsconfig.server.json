{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist-server",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "server/**/*.ts",
    "electron/services/authService.ts",
    "electron/services/runtimeLogger.ts",
    "electron/db/sqliteService.ts"
  ]
}
