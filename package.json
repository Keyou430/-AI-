{
  "name": "video-remix-ai-assistant",
  "version": "1.0.13",
  "description": "面向企业新媒体团队的视频脚本二创桌面助手",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && tsc -p tsconfig.node.json && cross-env NODE_ENV=development electron .\"",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke:desktop": "electron scripts/desktopSmoke.cjs",
    "smoke:packaged": "electron scripts/desktopSmoke.cjs release/win-unpacked/resources/app.asar",
    "pack:win": "npm run build && node scripts/prepareUniversalConfig.cjs && electron-builder --config electron-builder.universal.cjs --win --x64 --dir --publish never",
    "dist:win": "npm run build && node scripts/prepareUniversalConfig.cjs && electron-builder --config electron-builder.universal.cjs --win nsis --x64 --publish never",
    "postinstall": "install-electron --no",
    "build:auth": "tsc -p tsconfig.server.json",
    "start:auth": "node dist-server/server/main.js",
    "smoke:persistence": "node scripts/desktopPersistenceSmoke.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.8.0",
    "motion": "^14.6.0",
    "openai": "^4.71.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "^7.3.7",
    "wait-on": "^8.0.1"
  },
  "author": "Keyou430",
  "repository": {
    "type": "git",
    "url": "https://github.com/Keyou430/-AI-.git"
  },
  "build": {
    "appId": "com.keyou430.video-remix-ai-assistant",
    "productName": "视频二创AI助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm",
      "node_modules/better-sqlite3/**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "executableName": "video-remix-ai-assistant",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "video-remix-ai-assistant-setup-${version}.exe"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "authMode": "local"
}
