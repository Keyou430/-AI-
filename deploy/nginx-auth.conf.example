# 替换 auth.example.com 和证书路径后，用 nginx -t 验证。
# limit_req_zone 须位于 http 上下文，本文件可由 sites-enabled 引入。
limit_req_zone $binary_remote_addr zone=remix_auth_login:10m rate=5r/m;
server {
    listen 80;
    server_name auth.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name auth.example.com;
    ssl_certificate /etc/letsencrypt/live/auth.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/auth.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    location = /v1/login {
        limit_req zone=remix_auth_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_connect_timeout 2s;
        proxy_read_timeout 180s;
    }
    location / {
        proxy_pass http://127.0.0.1:3080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_connect_timeout 2s;
        proxy_read_timeout 180s;
    }
}
